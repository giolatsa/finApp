<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <EditText
        android:id="@+id/ab_edit_salary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ხელფასი"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="50dp"/>

    <EditText
        android:id="@+id/ab_edit_rent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ქირა"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/ab_edit_salary"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/ab_edit_food"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="კვება"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/ab_edit_rent"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/ab_btn_calculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculate"
        app:layout_constraintTop_toBottomOf="@id/ab_edit_food"
        android:layout_marginTop="40dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
